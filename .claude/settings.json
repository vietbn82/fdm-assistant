{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python acslicer_tune.py --list)",
      "Bash(python acslicer_tune.py --audit*)",
      "Bash(python acslicer_tune.py --show*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "PowerShell(Get-Process*)"
    ],
    "ask": [
      "Bash(python acslicer_tune.py --fix*)",
      "Bash(python acslicer_tune.py --set*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Edit(//C/Users/*/AppData/Roaming/AnycubicSlicerNext/system/**)",
      "Write(//C/Users/*/AppData/Roaming/AnycubicSlicerNext/system/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_system_presets.py\"",
            "timeout": 10,
            "statusMessage": "Checking vendor preset guard"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_status.py\"",
            "timeout": 15,
            "statusMessage": "Reading Anycubic project status"
          }
        ]
      }
    ]
  }
}
